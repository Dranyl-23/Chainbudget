# Smart Contracts Deployment Configuration
# Copy this file to .env and configure your deployer key.
# NEVER commit .env to git.

# ── Deployer Wallet Private Key (64-hex string; with or without 0x prefix)
# This MUST be a dedicated deployer wallet, separate from backend relayer and user wallets.
PRIVATE_KEY=your_deployer_wallet_private_key_here

# ── Constructor Governance Parameters (Step 2 before Amoy deploy)
# Second L1 wallet co-owning/approving multi-sig operations (must be a wallet you control)
SECONDARY_APPROVER_ADDRESS=0x0000000000000000000000000000000000000000
REQUIRED_APPROVALS=2

# ── Polygon Amoy RPC Endpoint
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# ── Polygonscan API Key (Optional — for contract verification)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
