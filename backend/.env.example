# Backend — Environment Variables Template
# Copy this file to .env and fill in your environment-specific values.
# DO NOT commit .env files containing real secrets to version control.

# ── MongoDB Database Configuration
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/chainbudget?retryWrites=true&w=majority

# ── Authentication & Security Secrets
# Generate a cryptographically secure 256-bit key: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here

# 256-bit encryption key for sensitive stored wallet data (Must be exactly 32 characters)
ENCRYPTION_SECRET=your_32_char_encryption_secret!

# CSRF token signing secret (required — application will refuse to start if missing)
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=<generate-a-strong-random-secret>

# ── Application Endpoints & Environment
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PORT=5001

# ── Smart Contract Addresses (Polygon Amoy Testnet)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DAO_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Blockchain Service / Relayer Wallet
# This is a dedicated backend relayer key (NOT your personal wallet, NOT the contract deployer)
BACKEND_WALLET_PRIVATE_KEY=your_backend_relayer_private_key_here

# ── RPC Provider
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ── Asgardeo Identity & Access Management (OIDC)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org-handle>
# Used for JWT audience validation — set this to your Asgardeo application's Client ID
ASGARDEO_CLIENT_ID=your_asgardeo_client_id_here
ASGARDEO_CLIENT_SECRET=your_asgardeo_client_secret_here

# ── IPFS / Pinata Document Storage
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── SMTP / Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_notification_email@example.com
SMTP_PASSWORD=your_smtp_app_password_here

# ── Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash