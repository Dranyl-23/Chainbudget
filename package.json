{
  "name": "chainbudget-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npx expo start",
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:mobile\"",
    "test:contracts": "cd contracts && npx hardhat test",
    "lint:frontend": "cd frontend && npx tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
