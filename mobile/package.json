{
  "name": "Chainbudget",
  "version": "1.1.11",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "axios": "^1.19.0",
    "ethers": "^6.17.0",
    "expo": "^53.0.27",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-local-authentication": "~16.0.5",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.5",
    "expo-screen-capture": "~7.2.0",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "lottie-react-native": "7.2.2",
    "nativewind": "^2.0.11",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-metro.js",
    "bump": "node scripts/bump-version.js patch",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build:apk": "node scripts/bump-version.js patch && eas build -p android --profile production",
    "build:apk:minor": "node scripts/bump-version.js minor && eas build -p android --profile production",
    "build:preview": "node scripts/bump-version.js patch && eas build -p android --profile preview"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "ethers",
          "socket.io-client",
          "react-native-keyboard-aware-scroll-view"
        ]
      }
    }
  },
  "private": true
}
