{
  "name": "Chainbudget",
  "version": "1.1.14",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "axios": "^1.19.0",
    "ethers": "^6.17.0",
    "expo": "^58.0.22",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "lottie-react-native": "~7.5.0",
    "nativewind": "^2.0.11",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:tunnel": "expo start --tunnel -c",
    "start:lan": "expo start --lan -c",
    "start:localhost": "expo start --localhost -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-metro.js",
    "bump": "node scripts/bump-version.js patch",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build:apk": "node scripts/bump-version.js patch && eas build -p android --profile production",
    "build:apk:minor": "node scripts/bump-version.js minor && eas build -p android --profile production",
    "build:preview": "node scripts/bump-version.js patch && eas build -p android --profile preview"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "ethers",
          "socket.io-client",
          "react-native-keyboard-aware-scroll-view"
        ]
      }
    }
  },
  "private": true
}
