{
  "expo": {
    "name": "ChainBudget",
    "slug": "lynard",
    "version": "1.1.13",
    "scheme": "chainbudget",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#09090b",
    "splash": {
      "image": "./assets/3D-Chainbudget.png",
      "resizeMode": "contain",
      "backgroundColor": "#05040F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chainbudget.app",
      "buildNumber": "15"
    },
    "android": {
      "package": "com.chainbudget.app",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#05040F",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/android-icon-monochrome.png",
      "color": "#a21caf"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Chainbudget needs access to your camera to scan transaction receipts."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#a21caf"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://chainbudget-api.fly.dev/api",
      "eas": {
        "projectId": "85dd7732-5fd7-438e-8e34-6d2246d7426a"
      }
    },
    "owner": "askyyys-team"
  }
}
